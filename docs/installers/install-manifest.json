{
  "bootstrap": {
    "default_port": 8080,
    "flags": [
      {
        "env": "AF_PROFILE",
        "ps": "-Profile",
        "sh": "--profile auto|light|apple|gpu",
        "summary": "Install profile; auto picks apple on Apple Silicon macOS 14+, gpu when nvidia-smi/rocminfo works, light otherwise."
      },
      {
        "env": "AF_PORT",
        "ps": "-Port",
        "sh": "--port N",
        "summary": "Gateway port (default 8080; the next free port when 8080 is busy)."
      },
      {
        "env": "AF_PIN",
        "ps": "-Pin",
        "sh": "--pin VERSION|latest",
        "summary": "abstractgateway version (default: bootstrap.gateway_version)."
      },
      {
        "env": "AF_FROM",
        "ps": "-From",
        "sh": "--from PATH|REQUIREMENT",
        "summary": "Install the gateway from a checkout, wheel or requirement (testing)."
      },
      {
        "env": "AF_DATA_DIR",
        "ps": "-DataDir",
        "sh": "--data-dir DIR",
        "summary": "Gateway data dir (default: the per-OS user data dir)."
      },
      {
        "env": "",
        "ps": "-WithApps",
        "sh": "--with-apps",
        "summary": "Ensure Node.js >= 18 for the npx browser apps (uv tool install nodejs-wheel)."
      },
      {
        "env": "",
        "ps": "-WithConsole",
        "sh": "--with-console",
        "summary": "cargo install abstractgateway-console when cargo exists."
      },
      {
        "env": "",
        "ps": "-WithCodeCli",
        "sh": "--with-code-cli",
        "summary": "cargo install abstractcode (terminal client) when cargo exists."
      },
      {
        "env": "",
        "ps": "-WithCoreCli",
        "sh": "--with-core-cli",
        "summary": "Also expose the abstractcore command (--with-executables-from abstractcore)."
      },
      {
        "env": "",
        "ps": "-WithOllama",
        "sh": "--with-ollama",
        "summary": "Run Ollama's official installer (Linux/macOS may ask for sudo)."
      },
      {
        "env": "",
        "ps": "-WithLmStudio",
        "sh": "--with-lmstudio",
        "summary": "Install LM Studio (headless llmster on macOS/Linux, winget on Windows)."
      },
      {
        "env": "",
        "ps": "-NoTray",
        "sh": "--no-tray",
        "summary": "Skip the tray extra."
      },
      {
        "env": "",
        "ps": "-NoService",
        "sh": "--no-service",
        "summary": "Do not register a login service; start the gateway in the background."
      },
      {
        "env": "",
        "ps": "-NoStart",
        "sh": "--no-start",
        "summary": "Install only."
      },
      {
        "env": "",
        "ps": "-NoOpen",
        "sh": "--no-open",
        "summary": "Do not open the browser."
      },
      {
        "env": "",
        "ps": "-Print",
        "sh": "--print",
        "summary": "Dry run: preflight, then print every command; change nothing."
      },
      {
        "env": "",
        "ps": "-Uninstall [-Purge]",
        "sh": "--uninstall [--purge]",
        "summary": "Remove the service and uv tools (purge also deletes the data dir)."
      }
    ],
    "gateway_version": "0.4.0",
    "optional_extras": [
      "tray"
    ],
    "profile_extras": {
      "apple": [
        "apple"
      ],
      "gpu": [
        "gpu"
      ],
      "light": []
    },
    "python": "3.12",
    "scripts": {
      "unix": {
        "one_liner": "curl -LsSf https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.sh | sh",
        "platforms": [
          "macos",
          "linux"
        ],
        "url": "https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.sh",
        "with_flags": "curl -LsSf https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.sh | sh -s -- --with-apps"
      },
      "windows": {
        "one_liner": "powershell -ExecutionPolicy ByPass -c \"irm https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.ps1 | iex\"",
        "platforms": [
          "windows"
        ],
        "url": "https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.ps1",
        "with_flags": "& ([scriptblock]::Create((irm https://raw.githubusercontent.com/lpalbou/AbstractFramework/main/scripts/install.ps1))) -WithApps"
      }
    },
    "steps": [
      "preflight (OS, arch, macOS >= 14 for apple, GPU driver for gpu, disk, port)",
      "install uv when missing (astral.sh official script, no admin)",
      "uv python install 3.12",
      "uv tool install --python 3.12 \"abstractgateway[<extras>]==<pin>\"",
      "optional: nodejs-wheel, cargo crates, Ollama / LM Studio vendor installers",
      "abstractgateway service install (when supported) or a background start",
      "wait for GET /api/health",
      "abstractgateway-config claim-url (when supported) and open /console"
    ],
    "tool_requirement": "abstractgateway[{extras}]==0.4.0",
    "uninstall": [
      [
        "abstractgateway",
        "service",
        "uninstall"
      ],
      [
        "uv",
        "tool",
        "uninstall",
        "abstractgateway"
      ]
    ]
  },
  "framework": {
    "distribution": "abstractframework",
    "id": "abstractframework",
    "name": "AbstractFramework",
    "python_requires": ">=3.10",
    "registry": "pypi",
    "version": "0.3.0"
  },
  "minimum_installer_version": "0.2.0",
  "npm_apps": [
    {
      "command": "npx @abstractframework/flow",
      "id": "flow",
      "package": "@abstractframework/flow",
      "registry": "npm",
      "version": "0.3.20"
    },
    {
      "command": "npx @abstractframework/code",
      "id": "code",
      "package": "@abstractframework/code",
      "registry": "npm",
      "version": "0.4.2"
    },
    {
      "command": "npx @abstractframework/observer",
      "id": "observer",
      "package": "@abstractframework/observer",
      "registry": "npm",
      "version": "0.1.12"
    },
    {
      "command": "npx @abstractframework/continuum",
      "id": "continuum",
      "package": "@abstractframework/continuum",
      "registry": "npm",
      "version": "0.2.0"
    },
    {
      "command": "npx @abstractframework/entity",
      "id": "entity",
      "package": "@abstractframework/entity",
      "registry": "npm",
      "version": "0.1.0"
    }
  ],
  "post_install": {
    "apps": [
      [
        "npx",
        "-y",
        "@abstractframework/flow"
      ],
      [
        "npx",
        "-y",
        "@abstractframework/code"
      ],
      [
        "npx",
        "-y",
        "@abstractframework/observer"
      ],
      [
        "npx",
        "-y",
        "@abstractframework/continuum"
      ],
      [
        "npx",
        "-y",
        "@abstractframework/entity"
      ]
    ],
    "claim": [
      "abstractgateway-config",
      "claim-url"
    ],
    "claim_fallback": {
      "command": [
        "abstractgateway-config",
        "bootstrap-admin",
        "--print-token"
      ],
      "token_file": "<data_dir>/auth/bootstrap-admin-token"
    },
    "console_url": "http://127.0.0.1:8080/console",
    "doctor": [
      "abstractframework",
      "doctor"
    ],
    "entrypoint": "console",
    "gateway": [
      "abstractgateway",
      "serve",
      "--host",
      "127.0.0.1",
      "--port",
      "8080"
    ],
    "health_url": "http://127.0.0.1:8080/api/health",
    "notes": "Providers, API keys, engines, models and users are configured in the gateway console (/console first-run wizard); every console action prints its CLI twin.",
    "service": [
      "abstractgateway",
      "service",
      "install"
    ]
  },
  "profiles": [
    {
      "best_for": [
        "cloud APIs",
        "LM Studio, Ollama, vLLM, llama.cpp, or other endpoint servers",
        "lowest-friction install"
      ],
      "excludes": [
        "local MLX engines",
        "local CUDA/ROCm engines"
      ],
      "id": "light",
      "local_inference": false,
      "name": "Light",
      "pip_requirements": [
        "abstractframework==0.3.0"
      ],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "prerequisites": [
        "python>=3.10",
        "network"
      ],
      "summary": "Remote-first install. Full framework functionality is available through remote or OpenAI-compatible endpoints; no local MLX, CUDA, Diffusers, or model-runtime stacks are installed by this profile."
    },
    {
      "best_for": [
        "Mac users who want local Apple Silicon inferencers"
      ],
      "excludes": [
        "CUDA/ROCm engines"
      ],
      "id": "apple",
      "local_inference": true,
      "name": "Apple",
      "pip_requirements": [
        "abstractframework[apple]==0.3.0"
      ],
      "platforms": [
        "macos"
      ],
      "prerequisites": [
        "python>=3.10",
        "apple-silicon",
        "macos>=14",
        "network"
      ],
      "summary": "Native Apple Silicon profile. Adds local MLX/Metal-capable stacks on top of the same framework interfaces and endpoint providers."
    },
    {
      "best_for": [
        "workstations or servers with supported discrete GPUs"
      ],
      "excludes": [
        "Apple MLX-only engines"
      ],
      "id": "gpu",
      "local_inference": true,
      "name": "GPU",
      "pip_requirements": [
        "abstractframework[gpu]==0.3.0"
      ],
      "platforms": [
        "linux",
        "windows"
      ],
      "prerequisites": [
        "python>=3.10",
        "gpu-driver",
        "network"
      ],
      "summary": "Native GPU profile. Adds CUDA/ROCm-oriented local stacks on top of the same framework interfaces and endpoint providers."
    }
  ],
  "python_packages": [
    {
      "distribution": "abstractcore",
      "id": "abstractcore",
      "registry": "pypi",
      "version": "2.15.0"
    },
    {
      "distribution": "AbstractRuntime",
      "id": "abstractruntime",
      "registry": "pypi",
      "version": "0.4.33"
    },
    {
      "distribution": "abstractagent",
      "id": "abstractagent",
      "registry": "pypi",
      "version": "0.3.13"
    },
    {
      "distribution": "abstractgateway",
      "id": "abstractgateway",
      "registry": "pypi",
      "version": "0.4.0"
    },
    {
      "distribution": "AbstractMemory",
      "id": "abstractmemory",
      "registry": "pypi",
      "version": "0.3.0"
    },
    {
      "distribution": "abstractsemantics",
      "id": "abstractsemantics",
      "registry": "pypi",
      "version": "0.0.5"
    },
    {
      "distribution": "abstractvoice",
      "id": "abstractvoice",
      "registry": "pypi",
      "version": "0.11.4"
    },
    {
      "distribution": "abstractvision",
      "id": "abstractvision",
      "registry": "pypi",
      "version": "0.3.29"
    },
    {
      "distribution": "abstractmusic",
      "id": "abstractmusic",
      "registry": "pypi",
      "version": "0.1.15"
    },
    {
      "distribution": "abstractassistant",
      "id": "abstractassistant",
      "registry": "pypi",
      "version": "0.5.0"
    }
  ],
  "schema_version": 2,
  "security": {
    "native_artifacts_signed": false,
    "notes": "The bootstrap is a script (curl | sh, irm | iex) that installs signed-by-vendor or PyPI/npm artifacts; nothing it runs needs our code signature. Only native double-click apps (AbstractAssistant .app, future launchers) need signing.",
    "secrets_in_manifest": false
  },
  "source": {
    "release_profile": "abstractframework.RELEASE_VERSIONS",
    "repository": "https://github.com/lpalbou/AbstractFramework"
  }
}
